<main class="min-h-screen bg-gray-100 px-4 py-8 sm:px-6">
  <div class="mx-auto max-w-3xl">
    <div class="mb-6">
      <a href="/admin" class="text-sm font-medium text-gray-700 no-underline hover:text-gray-900">&larr; Back to products</a>
    </div>

    <section class="border border-gray-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="add-product-heading">
      <header class="mb-6">
        <h1 id="add-product-heading" class="text-2xl font-semibold text-gray-900">Edit Product</h1>
        <p class="mt-1 text-base text-gray-700">Edit the product details...</p>
      </header>

      <form action="/admin/edit-product/{{product._id}}" method="post" enctype="multipart/form-data" class="flex flex-col gap-4">
        <div>
          <label for="name" class="mb-1 block text-base font-medium text-gray-800">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            value="{{product.name}}"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-base text-gray-800 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200"
          >
        </div>

        <div>
          <label for="category" class="mb-1 block text-base font-medium text-gray-800">Category</label>
          <input
            id="category"
            name="category"
            type="text"
            value="{{product.category}}"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-base text-gray-800 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200"
          >
        </div>

        <div>
          <label for="price" class="mb-1 block text-base font-medium text-gray-800">Price</label>
          <input
            id="price"
            name="price"
            type="number"
            min="0"
            step="0.01"
            value="{{product.price}}"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-base text-gray-800 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200"
          >
        </div>

        <div>
          <label for="description" class="mb-1 block text-base font-medium text-gray-800">Description</label>
          <textarea
            id="description"
            name="description"
            rows="3"
            class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-base text-gray-800 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200"
          >{{product.description}}</textarea>
        </div>

        <div>
          <label for="image" class="mb-1 block text-base font-medium text-gray-800">Image</label>
          <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <input
              id="image"
              name="image"
              type="file"
              accept="image/*"
              class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-base text-gray-800 file:mr-3 file:rounded-md file:border file:border-gray-300 file:bg-gray-100 file:px-3 file:py-1 file:text-gray-800"
            >
            <img
              id="imagePreview"
              src="/images/product-images/{{product.image}}"
              alt="{{product.name}}"
              class="h-28 w-28 shrink-0 rounded-md border border-gray-200 bg-gray-50 object-contain p-1"
            >
          </div>
        </div>
        <div class="mt-2">
          <button
            type="submit"
            class="rounded-md border border-green-600 bg-green-600 px-4 py-2 text-base font-medium text-white hover:bg-green-700 focus:outline-2 focus:outline-offset-2 focus:outline-green-600"
          >
            Add Product
          </button>
        </div>
      </form>
    </section>
  </div>
</main>

<script>
  const imageInput = document.getElementById('image');
  const imagePreview = document.getElementById('imagePreview');

  imageInput.addEventListener('change', () => {
    const file = imageInput.files[0];

    if (file) {
      imagePreview.src = URL.createObjectURL(file);
    }
  });
</script>
