<main class="bg-gray-100 px-4 py-8 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <header class="mb-5">
      <h1 class="text-2xl font-semibold text-gray-900">Products</h1>
      <p class="text-base text-gray-700">Manage the products in your store.</p>
    </header>

    <section class="overflow-hidden border border-gray-200 bg-white shadow-sm" aria-labelledby="product-list-heading">
      <div class="flex flex-wrap items-center gap-3 bg-gray-100 p-6">
        <div>
          <h2 id="product-list-heading" class="text-xl font-semibold text-gray-900">All products</h2>
          <p class="text-base text-gray-700">Your store inventory</p>
        </div>
        <span class="rounded-md bg-white px-3 py-2 text-base font-semibold text-gray-800">{{products.length}} products</span>
        <a href="/admin/add-product" class="inline-block bg-green-500 px-4 py-2 text-white font-medium rounded-lg hover:bg-green-700 transition duration-150 ease-in-out">
  Add Product
</a>

      </div>

      {{#if products.length}}
      <div class="px-6 pt-5">
        <label for="product-search" class="mb-2 block text-sm font-medium text-gray-900">Search products</label>
        <input
          id="product-search"
          type="search"
          class="w-full max-w-md rounded-md border border-gray-300 px-3 py-2 text-gray-900 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Search by name, category, or description"
          aria-describedby="product-search-results"
        >
        <p id="product-search-results" class="mt-2 text-sm text-gray-700" role="status" aria-live="polite">
          Showing {{products.length}} products
        </p>
      </div>
      <div class="overflow-hidden">
        <table class="w-full border">
          <thead class="bg-gray-100">
            <tr>
              <th class="border border-gray-200 px-4 py-3 text-gray-900" scope="col">No</th>
              <th class="border border-gray-200 px-4 py-3 text-gray-900" scope="col">Title</th>
              <th class="border border-gray-200 px-4 py-3 text-gray-900" scope="col">Category</th>
              <th class="border border-gray-200 px-4 py-3 text-gray-900" scope="col">Description</th>
              <th class="border border-gray-200 px-4 py-3 text-gray-900" scope="col">Image</th>
              <th class="border border-gray-200 px-4 py-3 text-gray-900" scope="col">Edit/Delete</th>
            </tr>
          </thead>
          <tbody id="product-table-body">
            {{#each products}}
            <tr class="product-row">
              <td class="border border-gray-200 px-4 py-3 text-gray-900">{{this.number}}</td>
              <td class="border border-gray-200 px-4 py-3 text-gray-900">{{this.name}}</td>
              <td class="border border-gray-200 px-4 py-3 text-gray-700">{{this.category}}</td>
              <td class="border border-gray-200 px-4 py-3 text-gray-700">{{this.description}}</td>
              <td class="border border-gray-200 px-4 py-3">
                <img class="rounded-md" src="/images/product-images/{{this.image}}" alt="{{this.name}}" width="48" height="48" loading="lazy">
              </td>
              <td>
                <a href="/admin/edit-product/{{this._id}}" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">Edit</a>
                <a href="/admin/delete-product/{{this._id}}"onclick="return confirm('Are you sure you want to delete {{this.name}}?')" class="bg-red-600 hover:bg-red-700 text-white font-medium px-4 py-2 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2">Delete</a>
                </td>
            </tr>
            {{/each}}
            <tr id="no-product-matches" hidden>
                <td colspan="6" class="px-4 py-6 text-center text-gray-700">No products match your search.</td>
            </tr>
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="flex flex-col items-center gap-3 p-6">
        <h3 class="text-xl font-semibold text-gray-900">No products yet</h3>
        <p class="text-base text-gray-700">Products added to your store will appear here.</p>
      </div>
      {{/if}}
    </section>
  </div>
</main>
