<main class="flex min-h-[calc(100vh-4rem)] items-center justify-center bg-slate-50 px-4 py-12 sm:px-6">
  <section class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white px-6 py-10 text-center shadow-sm sm:px-10 sm:py-12" aria-labelledby="order-success-heading">
    <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
      <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6" />
      </svg>
    </div>

    <p class="mt-6 text-sm font-semibold uppercase tracking-widest text-emerald-700">Order confirmed</p>
    <h1 id="order-success-heading" class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Thank you for your order!
    </h1>
    <p class="mt-4 text-base leading-7 text-slate-600">
      Your order has been placed successfully. You can check its status and details in your orders.
    </p>

    <a
      href="/orders"
      class="mt-8 inline-flex items-center justify-center rounded-md bg-blue-600 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
    >
      View Orders
    </a>
  </section>
</main>
