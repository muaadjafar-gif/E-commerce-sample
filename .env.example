# Runtime environment: use production when deploying.
NODE_ENV=development

# Optional locally; hosting platforms usually provide PORT.
PORT=8080

# Required in production. For local MongoDB, use the local URI below.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=shopping

# Required in production. Replace with a long, random value.
SESSION_SECRET=replace-with-a-long-random-secret

# Required for admin login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Required for product image uploads. Set these in Render's environment settings.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required to enable Razorpay payments. Set a matching key ID/secret pair
# from Razorpay Dashboard for the same mode (test or live); keep the secret private.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
